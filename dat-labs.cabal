cabal-version: 3.0
name:          dat-labs
version:       0.1.0.0
synopsis:      DAT Haskell lab exercises
license:       NONE
build-type:    Simple

-- =============================================================
-- Lab 1: Stack-based expression compiler/interpreter
-- =============================================================

-- Shared library for lab1 modules
library lab1-internals
  exposed-modules:
    Analitzador
    ECompile
    ESyntax
    Instr1
    Instr1Estat
    Instr2
    Instr3
    Ops
  hs-source-dirs: lab1
  build-depends:  base >=4.17 && <5
  default-language: Haskell2010
  ghc-options:    -Wall

-- mps1: basic stack machine (Instr1)
executable mps1
  main-is:        lab1/mps1.hs
  build-depends:  base >=4.17 && <5, dat-labs:lab1-internals
  default-language: Haskell2010
  ghc-options:    -Wall

-- mps2: stack machine with Maybe error handling (Instr2)
executable mps2
  main-is:        lab1/mps2.hs
  build-depends:  base >=4.17 && <5, dat-labs:lab1-internals
  default-language: Haskell2010
  ghc-options:    -Wall

-- mps3: stack machine with Either error handling (Instr3)
executable mps3
  main-is:        lab1/mps3.hs
  build-depends:  base >=4.17 && <5, dat-labs:lab1-internals
  default-language: Haskell2010
  ghc-options:    -Wall

-- me: full parser + compiler + interpreter
executable me
  main-is:        lab1/me.hs
  build-depends:  base >=4.17 && <5, dat-labs:lab1-internals
  default-language: Haskell2010
  ghc-options:    -Wall
