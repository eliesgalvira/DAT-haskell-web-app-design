
cabal-version: 1.12

name:           forums-frontend
version:        0.0.1.0
author:         Nom de l'autor
build-type:     Simple

executable forums-frontend
  hs-source-dirs:
      src
  main-is:
      Main.hs
  other-modules:
      ForumsApiSrv
      Route
      Pages.Forum
      Pages.Topic
      Pages.NotFound
      Components.UserComponent
      Components.NewTopicForm
      Utils Utils.Url
      Utils.Markdown
  build-depends:
      base >=4.7 && <5,
      containers,
      http-types,
      miso >=1.9 && <1.10,
      miso-from-html,
      mtl,
      text
  default-language: Haskell2010

