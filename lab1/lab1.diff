 type Stack = [Int]
 
-{- A completar per l'estudiant:
-    runTop :: Stack -> Either String Int
-    runInstrs :: IProgram -> Stack -> Either String Stack
-    runInstr1 :: Instr -> Stack -> Either String Stack
